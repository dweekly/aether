---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';

const title = "Aether Flight";
const description = "Aether Flight — data-driven stories about general aviation in America. A project of Primatech Paper Co LLC.";
---

<BaseLayout title={`${title} | Ether Flight`} description={description}>
	<Fragment slot="head">
		<!-- Schema.org -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Organization",
			"name": "Aether Flight",
			"alternateName": ["Ether Flight", "AetherFlight"],
			"url": "https://aether-flight.com",
			"email": "team@aether-flight.com",
			"parentOrganization": {
				"@type": "Organization",
				"name": "Primatech Paper Co LLC"
			}
		})} />
	</Fragment>

	<main class="landing">
		<div class="mark">
			<span class="mark-line mark-line--1" aria-hidden="true"></span>
			<h1>
				<span class="letter-group" style="--i:0">A</span><span class="letter-group" style="--i:1">e</span><span class="letter-group" style="--i:2">t</span><span class="letter-group" style="--i:3">h</span><span class="letter-group" style="--i:4">e</span><span class="letter-group" style="--i:5">r</span><span class="spacer"> </span><span class="letter-group" style="--i:6">F</span><span class="letter-group" style="--i:7">l</span><span class="letter-group" style="--i:8">i</span><span class="letter-group" style="--i:9">g</span><span class="letter-group" style="--i:10">h</span><span class="letter-group" style="--i:11">t</span>
			</h1>
			<span class="mark-line mark-line--2" aria-hidden="true"></span>
		</div>

		<p class="tagline">Data-driven stories about general aviation in America.</p>

		<section class="stories-preview">
			<a href="/stories/cessna-172-rental-cost" class="story-card">
				<span class="story-label">Latest</span>
				<h2>What Does It Cost to Rent a Cessna 172?</h2>
				<p>We analyzed rental rates from thousands of flight schools to map the true cost of flying across America.</p>
			</a>
		</section>

		<div class="contact">
			<a href="mailto:team@aether-flight.com">team@aether-flight.com</a>
		</div>
	</main>

	<Footer />

	<!-- SEO: hidden semantic content -->
	<div class="sr-only" aria-hidden="true">
		<p>Aether Flight, also known as Ether Flight or AetherFlight, publishes data-driven stories about general aviation using comprehensive datasets on flight schools, rental rates, and training aircraft across America.</p>
	</div>
</BaseLayout>

<style>
	.landing {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4rem;
		padding: 2rem;
		min-height: 100vh;
		justify-content: center;
	}

	/* Wordmark */
	.mark {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0;
	}

	h1 {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(2.8rem, 8vw, 5.5rem);
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--text-bright);
		text-align: center;
		line-height: 1;
		padding: 1.2rem 0;
	}

	.letter-group {
		display: inline-block;
		animation: fadeIn 0.8s ease both;
		animation-delay: calc(0.6s + var(--i) * 0.06s);
	}

	.spacer {
		display: inline-block;
		width: 0.3em;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* Decorative lines */
	.mark-line {
		display: block;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--line) 20%, var(--accent) 50%, var(--line) 80%, transparent);
		opacity: 0;
	}

	.mark-line--1 {
		width: min(70vw, 500px);
		animation: lineReveal 1.2s ease 0.3s both;
	}

	.mark-line--2 {
		width: min(50vw, 360px);
		animation: lineReveal 1.2s ease 1.5s both;
	}

	@keyframes lineReveal {
		from {
			opacity: 0;
			width: 0;
		}
		to {
			opacity: 0.4;
		}
	}

	/* Tagline */
	.tagline {
		font-family: var(--font-display);
		font-size: clamp(0.95rem, 2vw, 1.15rem);
		font-weight: 300;
		font-style: italic;
		color: var(--text-dim);
		letter-spacing: 0.04em;
		text-align: center;
		max-width: 32ch;
		line-height: 1.6;
		animation: fadeIn 0.8s ease 1.8s both;
	}

	/* Stories preview */
	.stories-preview {
		animation: fadeIn 0.8s ease 2.0s both;
		max-width: 40ch;
		width: 100%;
	}

	.story-card {
		display: block;
		padding: 1.5rem;
		border: 1px solid var(--line);
		border-radius: 2px;
		text-decoration: none;
		transition: border-color 0.4s ease, background 0.4s ease;
	}

	.story-card:hover {
		border-color: var(--accent);
		background: var(--glow);
	}

	.story-label {
		font-family: var(--font-mono);
		font-size: 0.6rem;
		font-weight: 400;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.story-card h2 {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 1.2rem;
		color: var(--text-bright);
		line-height: 1.35;
		margin: 0.5rem 0;
	}

	.story-card p {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 300;
		color: var(--text-dim);
		line-height: 1.6;
	}

	/* Contact */
	.contact {
		animation: fadeIn 0.8s ease 2.2s both;
	}

	.contact a {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 300;
		letter-spacing: 0.12em;
		color: var(--text-dim);
		text-decoration: none;
		transition: color 0.5s ease;
		position: relative;
	}

	.contact a::after {
		content: '';
		position: absolute;
		bottom: -4px;
		left: 0;
		right: 0;
		height: 1px;
		background: var(--accent);
		transform: scaleX(0);
		transition: transform 0.4s ease;
	}

	.contact a:hover {
		color: var(--text-bright);
	}

	.contact a:hover::after {
		transform: scaleX(1);
	}

	@media (max-width: 480px) {
		h1 {
			letter-spacing: 0.15em;
		}

		.contact a {
			font-size: 0.7rem;
		}
	}
</style>
