---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const stories = [
	{
		slug: 'cessna-172-rental-cost',
		title: 'What Does It Cost to Rent a Cessna 172?',
		description: 'We analyzed 1,586 rental rates from flight schools across America to map the true cost of renting the world\'s most popular training aircraft.',
		publishDate: '2026-04-06',
	},
];
---

<BaseLayout title="Stories — Aether Flight" description="Data-driven stories about general aviation in America.">
	<Header />

	<main class="stories-page">
		<h1>Stories</h1>
		<p class="intro">Data-driven analysis of general aviation in America.</p>

		<ul class="story-list">
			{stories.map((story) => (
				<li>
					<a href={`/stories/${story.slug}`} class="story-item">
						<time class="story-date">
							{new Date(story.publishDate).toLocaleDateString('en-US', {
								year: 'numeric',
								month: 'long',
								day: 'numeric',
							})}
						</time>
						<h2>{story.title}</h2>
						<p>{story.description}</p>
					</a>
				</li>
			))}
		</ul>
	</main>

	<Footer />
</BaseLayout>

<style>
	.stories-page {
		position: relative;
		z-index: 1;
		max-width: var(--prose-width);
		margin: 0 auto;
		padding: 4rem 2rem;
	}

	h1 {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: 2.2rem;
		color: var(--text-bright);
		letter-spacing: 0.05em;
		margin-bottom: 0.5rem;
	}

	.intro {
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 300;
		font-style: italic;
		color: var(--text-dim);
		margin-bottom: 3rem;
	}

	.story-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.story-item {
		display: block;
		padding: 1.5rem;
		border: 1px solid var(--line);
		border-radius: 2px;
		text-decoration: none;
		transition: border-color 0.4s ease, background 0.4s ease;
	}

	.story-item:hover {
		border-color: var(--accent);
		background: var(--glow);
	}

	.story-date {
		font-family: var(--font-mono);
		font-size: 0.6rem;
		font-weight: 400;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.story-item h2 {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 1.3rem;
		color: var(--text-bright);
		line-height: 1.35;
		margin: 0.4rem 0;
	}

	.story-item p {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 300;
		color: var(--text-dim);
		line-height: 1.6;
	}
</style>
