---
interface Props {
	dataPath: string;
	title?: string;
	caption?: string;
}

const { dataPath, title, caption } = Astro.props;
---

<figure class="chart-figure reveal">
	{title && <figcaption class="chart-title">{title}</figcaption>}
	<div class="chart-container" data-chart="scatter" data-path={dataPath}></div>
	{caption && <p class="chart-caption">{caption}</p>}
</figure>

<script>
	import * as Plot from '@observablehq/plot';

	function renderScatters() {
		document.querySelectorAll('[data-chart="scatter"]').forEach(async (container) => {
			const path = container.getAttribute('data-path');
			if (!path || container.hasAttribute('data-rendered')) return;
			container.setAttribute('data-rendered', 'true');

			const resp = await fetch(path);
			const data = await resp.json();

			const withYear = data.filter((d: any) => d.year && d.year >= 1960 && d.year <= 2026);

			function render() {
				const width = container.clientWidth;
				if (width < 100) return;

				const chart = Plot.plot({
					width,
					height: 360,
					marginLeft: 55,
					marginBottom: 40,
					marginTop: 20,
					style: {
						background: 'transparent',
						color: '#d8dae0',
						fontFamily: "'Azeret Mono', monospace",
						fontSize: '11px',
					},
					x: {
						label: 'Year manufactured',
						tickFormat: (d: number) => String(d),
					},
					y: {
						label: '$/hr',
						tickFormat: (d: number) => `$${d}`,
						grid: true,
					},
					marks: [
						// Production gap annotation: 1986–1996
						Plot.rectX([{ x1: 1986, x2: 1997 }], {
							x1: 'x1',
							x2: 'x2',
							fill: '#fde725',
							fillOpacity: 0.06,
						}),
						Plot.text([{ x: 1991.5, label: 'No production\n1986–1996' }], {
							x: 'x',
							text: 'label',
							fill: '#fde725',
							fillOpacity: 0.5,
							fontSize: 10,
							frameAnchor: 'top',
							dy: 15,
							lineAnchor: 'top',
						}),
						Plot.dot(withYear, {
							x: 'year',
							y: 'rate',
							fill: '#7b8a9e',
							fillOpacity: 0.4,
							r: 3,
							tip: true,
						}),
						Plot.linearRegressionY(withYear, {
							x: 'year',
							y: 'rate',
							stroke: '#b8c4d4',
							strokeWidth: 1.5,
							strokeDasharray: '6,4',
						}),
					],
				});

				container.replaceChildren(chart);
			}

			render();
			const ro = new ResizeObserver(() => render());
			ro.observe(container);
		});
	}

	renderScatters();
	document.addEventListener('astro:page-load', renderScatters);
</script>

<style>
	.chart-figure {
		margin: 2rem 0;
	}

	.chart-title {
		font-family: var(--font-display);
		font-size: 1.1rem;
		font-weight: 400;
		color: var(--text-bright);
		margin-bottom: 0.75rem;
	}

	.chart-container {
		width: 100%;
		min-height: 360px;
	}

	.chart-container :global(svg) {
		overflow: visible;
	}

	.chart-container :global([aria-label="y-grid"] line) {
		stroke: #1e2028;
	}

	.chart-caption {
		font-family: var(--font-mono);
		font-size: 0.6rem;
		font-weight: 300;
		color: var(--text-dim);
		margin-top: 0.5rem;
		line-height: 1.5;
	}
</style>
