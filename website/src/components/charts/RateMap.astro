---
interface Props {
	dataPath: string;
	title?: string;
	caption?: string;
}

const { dataPath, title, caption } = Astro.props;
---

<figure class="chart-figure reveal">
	{title && <figcaption class="chart-title">{title}</figcaption>}
	<div class="map-container" data-chart="ratemap" data-path={dataPath}></div>
	<div class="map-legend">
		<span class="legend-label">$100/hr</span>
		<div class="legend-bar"></div>
		<span class="legend-label">$250+/hr</span>
	</div>
	{caption && <p class="chart-caption">{caption}</p>}
</figure>

<script>
	async function renderMaps() {
		const containers = document.querySelectorAll('[data-chart="ratemap"]');
		if (!containers.length) return;

		const maplibregl = await import('maplibre-gl');

		containers.forEach(async (container) => {
			const path = container.getAttribute('data-path');
			if (!path || container.hasAttribute('data-rendered')) return;
			container.setAttribute('data-rendered', 'true');

			const resp = await fetch(path);
			const points = await resp.json();

			const map = new maplibregl.Map({
				container: container as HTMLElement,
				style: {
					version: 8,
					sources: {
						'carto-dark': {
							type: 'raster',
							tiles: [
								'https://a.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}@2x.png',
								'https://b.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}@2x.png',
							],
							tileSize: 256,
							attribution: '',
						},
					},
					layers: [{
						id: 'carto-dark',
						type: 'raster',
						source: 'carto-dark',
						minzoom: 0,
						maxzoom: 19,
					}],
				},
				center: [-98.5, 39.5],
				zoom: 3.5,
				maxZoom: 12,
				minZoom: 2,
				attributionControl: false,
			});

			map.on('load', () => {
				map.addSource('schools', {
					type: 'geojson',
					data: {
						type: 'FeatureCollection',
						features: points.map(p => ({
							type: 'Feature',
							geometry: { type: 'Point', coordinates: [p.lng, p.lat] },
							properties: {
								rate: p.rate,
								school: p.school,
								airport: p.airport,
								state: p.state,
								count: p.count,
							},
						})),
					},
				});

				// Bold diverging color scale: green (cheap) → yellow (mid) → red (expensive)
				map.addLayer({
					id: 'school-circles',
					type: 'circle',
					source: 'schools',
					paint: {
						'circle-radius': [
							'interpolate', ['linear'], ['zoom'],
							3, 7,
							6, 10,
							8, 14,
							12, 18,
						],
						'circle-color': [
							'interpolate', ['linear'], ['get', 'rate'],
							100, '#22b573',    // cheap: vivid green
							140, '#5ec962',    // green-yellow
							165, '#c4e54a',    // yellow-green
							180, '#fde725',    // median: bright yellow
							200, '#f89540',    // above median: orange
							230, '#e45a31',    // expensive: red-orange
							280, '#c42a22',    // very expensive: deep red
						],
						'circle-opacity': 0.85,
						'circle-stroke-width': 1.5,
						'circle-stroke-color': '#08090c',
						'circle-stroke-opacity': 0.8,
					},
				});

				// Popup on click — anchor to feature geometry, not click position
				map.on('click', 'school-circles', (e) => {
					const f = e.features?.[0];
					if (!f || !f.geometry || f.geometry.type !== 'Point') return;
					const coords = (f.geometry as GeoJSON.Point).coordinates.slice() as [number, number];
					const p = f.properties;

					// Handle world-wrap: ensure popup is near the click
					while (Math.abs(e.lngLat.lng - coords[0]) > 180) {
						coords[0] += e.lngLat.lng > coords[0] ? 360 : -360;
					}

					const el = document.createElement('div');
					el.style.cssText = "font-family: 'Azeret Mono', monospace; font-size: 11px; color: #08090c; line-height: 1.5;";

					const name = document.createElement('strong');
					name.textContent = p.school;
					el.appendChild(name);

					el.appendChild(document.createElement('br'));

					const info = document.createTextNode(`${p.airport} · ${p.state}`);
					el.appendChild(info);

					el.appendChild(document.createElement('br'));

					const rate = document.createElement('span');
					rate.style.cssText = 'font-size: 14px; font-weight: bold;';
					rate.textContent = `$${p.rate}/hr`;
					el.appendChild(rate);

					if (p.count > 1) {
						el.appendChild(document.createElement('br'));
						const note = document.createElement('span');
						note.style.color = '#666';
						note.textContent = `${p.count} C172s, avg rate`;
						el.appendChild(note);
					}

					new maplibregl.Popup({ offset: 12, maxWidth: '260px' })
						.setLngLat(coords)
						.setDOMContent(el)
						.addTo(map);
				});

				map.on('mouseenter', 'school-circles', () => {
					map.getCanvas().style.cursor = 'pointer';
				});
				map.on('mouseleave', 'school-circles', () => {
					map.getCanvas().style.cursor = '';
				});
			});
		});
	}

	// Lazy-load: only render when map is visible
	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					renderMaps();
					observer.disconnect();
				}
			});
		},
		{ rootMargin: '200px' }
	);

	document.querySelectorAll('[data-chart="ratemap"]').forEach(el => observer.observe(el));
	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll('[data-chart="ratemap"]').forEach(el => observer.observe(el));
	});
</script>

<style>
	.chart-figure {
		margin: 2rem 0;
	}

	.chart-title {
		font-family: var(--font-display);
		font-size: 1.1rem;
		font-weight: 400;
		color: var(--text-bright);
		margin-bottom: 0.75rem;
	}

	.map-container {
		width: 100%;
		height: 550px;
		border: 1px solid var(--line);
		border-radius: 2px;
	}

	.map-legend {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.5rem;
	}

	.legend-label {
		font-family: var(--font-mono);
		font-size: 0.6rem;
		font-weight: 400;
		color: var(--text);
		letter-spacing: 0.05em;
	}

	.legend-bar {
		flex: 1;
		max-width: 200px;
		height: 8px;
		border-radius: 2px;
		background: linear-gradient(to right, #22b573, #5ec962, #c4e54a, #fde725, #f89540, #e45a31, #c42a22);
	}

	.chart-caption {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		font-weight: 400;
		color: var(--text);
		margin-top: 0.5rem;
		line-height: 1.6;
	}

	/* Hide MapLibre default attribution (credited in caption) */
	.map-container :global(.maplibregl-ctrl-attrib) {
		display: none;
	}

	@media (max-width: 768px) {
		.map-container {
			height: 400px;
		}
	}
</style>
