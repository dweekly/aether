---
interface Props {
	value: string;
	label: string;
	note?: string;
}

const { value, label, note } = Astro.props;
---

<div class="stat">
	<span class="stat-value">{value}</span>
	<span class="stat-label">{label}</span>
	{note && <span class="stat-note">{note}</span>}
</div>

<style>
	.stat {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		padding: 1.5rem 0;
	}

	.stat-value {
		font-family: var(--font-display);
		font-size: 2.5rem;
		font-weight: 300;
		color: var(--text-bright);
		letter-spacing: 0.02em;
		line-height: 1;
	}

	.stat-label {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		font-weight: 300;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-dim);
	}

	.stat-note {
		font-family: var(--font-mono);
		font-size: 0.6rem;
		font-weight: 300;
		color: var(--text-dim);
		opacity: 0.7;
	}
</style>
